FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev=false
COPY server ./server
COPY src/cooking/ingredients.ts src/cooking/logic.ts src/cooking/matchProtocol.ts ./src/cooking/
COPY tsconfig.json ./
ENV HOST=0.0.0.0
ENV PORT=8080
EXPOSE 8080
CMD ["npx", "tsx", "server/matchServer.ts"]
